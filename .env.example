# =============================================================================
# Business Ops Agent Swarm — Example environment configuration
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Core ---
ENVIRONMENT=local                 # local | development | staging | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# Minimum authn boundary (X-API-Key header). Empty = open (local default).
API_KEY=

# Per-tenant keys: X-API-Key value -> organization_id (UUID string).
# When non-empty, callers are bound to their organization server-side;
# client-supplied organization_id values are ignored everywhere.
# Format: JSON object mapping key string to org UUID, e.g. {"tenant-key-a": "11111111-1111-1111-1111-111111111111"}
TENANT_API_KEYS=

# Rate limiting: requests per minute per API key (sliding window).
# Set to 0 to disable. Default 60 req/min for production pilot.
RATE_LIMIT_PER_MINUTE=60

# --- Database (Neon PostgreSQL in production) ---
# Local dev can point at the docker-compose postgres (pgvector) container,
# or directly at your Neon connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/business_ops

# When true, POST /v1/tasks persists task progress and final results to the
# database and enables idempotent replay. Docker compose defaults this to true;
# keep false for pure off-line dev/CI.
PERSISTENCE_ENABLED=false

# --- LLM provider ---
# One of: mock | cloudflare_ai | external_openai_compatible | ollama
# Application MUST run without Ollama; "mock" requires no credentials at all.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# --- Embedding provider ---
# One of: mock | cloudflare_ai | external_openai_compatible
# Application MUST run without external services; "mock" requires no credentials.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768

# --- Cloudflare Workers AI (optional provider) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Ollama (OPTIONAL provider only — never required to run the system) ---
OLLAMA_BASE_URL=

# --- Email (support agent) ---
# SMTP settings for send_email_reply tool. DRY-RUN mode is DEFAULT (draft-only;
# real send behind email_send_enabled flag). YAGNI: no retries/queueing.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SEND_ENABLED=false  # DRY-RUN default: False = draft-only
# Explicit recipient allowlist for send_email_reply when sending is enabled.
# Recipients must also match the conversation's customer record otherwise.
EMAIL_RECIPIENT_ALLOWLIST=

# --- Gmail API (support agent) ---
# Gmail API settings for send_gmail_reply tool. DRY-RUN mode is DEFAULT (draft-only;
# real send behind gmail_send_enabled flag). Uses OAuth2 refresh token flow.
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SHEET_ID=
GMAIL_SEND_ENABLED=false  # DRY-RUN default: False = draft-only
# Explicit recipient allowlist for send_gmail_reply when sending is enabled.
# Recipients must also match the conversation's customer record otherwise.
GMAIL_ALLOWED_RECIPIENTS=

# --- Business Ops Hub (Task 2) ---
# Optional operational to-do items aggregated into the /ops digest + 08:00
# scheduler job. JSON list; each task: {"title", "due"(ISO8601, opt),
# "priority"(low|normal|high), "done"(bool)}. Leave empty to read ops.tasks
# from config.yaml instead. Real data only — never fabricated by the agent.
OPS_TASKS=

# --- Reporting (Phase 5) ---
# When true, ReportingAgent.generate appends a summary row to the configured
# Google Sheet (google_sheet_id must also be set). Defaults to false (no side
# effects in CI/dev).
REPORTING_SHEET_LOG_ENABLED=false

# --- n8n (integration layer) ---
# Basic auth for n8n UI (set in docker-compose.yml)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin

# n8n webhook URL for approved PO export (Phase D). Leave empty to disable
# (the supply chain graph degrades gracefully — export becomes a no-op).
N8N_WEBHOOK_URL=

# Slack webhook for escalation alerts (used by n8n workflows)
SLACK_WEBHOOK_URL=

# Gmail sender email for n8n workflow (optional)
GMAIL_SENDER_EMAIL=

# Timezone for n8n
TZ=UTC

# --- Monitoring agent (Phase B) ---
# When true, the scheduler runs (health check every interval, daily report).
MONITORING_SCHEDULER_ENABLED=true
# Health check cadence in minutes.
HEALTH_CHECK_INTERVAL_MINUTES=30
# Daily report cron (minute hour * * *). Default 09:00.
DAILY_REPORT_CRON=0 9 * * *
# Telegram push (optional). Token/chat from env; never stored in plaintext config.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tracing (Phase E) ---
# One of: (unset) | langfuse | otel . Default = no-op tracer (records nothing).
TRACING_BACKEND=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Phase 1+: Observability / Security (ADR-009..012) ---
# Input Filter Layer: sanitize raw text before any LLM call (spam, injection, PII)
INPUT_FILTER_ENABLED=true
INPUT_MAX_CHARS=8000
PII_MASKING_ENABLED=true
# Learning loop: daily cycle re-derives routing rules from feedback
LEARNING_ENABLED=true
LEARNING_CRON_HOUR=3  # UTC hour for the daily learning cycle

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000